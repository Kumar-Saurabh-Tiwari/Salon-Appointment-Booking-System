PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=12h

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=salon_booking

# Cancellation and rescheduling require this much advance notice.
CANCELLATION_CUTOFF_HOURS=24
SALON_TIMEZONE=UTC

# Optional SMTP email delivery. Without SMTP the API logs that email was skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# If blank, an email-formatted SMTP_USER is used as the sender.
SMTP_FROM=

# Optional Stripe Checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
STRIPE_SUCCESS_URL=http://localhost:5173/?payment=success
STRIPE_CANCEL_URL=http://localhost:5173/?payment=cancelled

# Used by `npm run seed:admin`; never expose these values to the frontend.
ADMIN_NAME=Salon Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
